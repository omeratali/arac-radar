# Araç Radar Sunucu Yapılandırması
PORT=8765
HOST=0.0.0.0
ALLOW_REMOTE=1

# Uzaktan erişim güvenliği (Boş bırakılırsa şifre sormaz; dış sunucuda mutlaka doldurun)
AUTH_USER=admin
AUTH_PASS=guclu_bir_sifre_belirleyin

# Opsiyonel: Ev IP'si / Residential Proxy veya Tailscale SOCKS5/HTTP Proxy
# Örn: http://kullanici:sifre@ip:port veya socks5://127.0.0.1:1055
PROXY_URL=

# Zaman dilimi
TZ=Europe/Istanbul
